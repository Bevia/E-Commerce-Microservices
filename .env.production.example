# Copy this file to .env.production and replace every change-me value.
# Never commit .env.production.

GATEWAY_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Generate with: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=change-me-with-a-base64-secret-of-at-least-32-bytes

AUTH_DB_PASSWORD=change-me-auth-database-password
ORDER_DB_PASSWORD=change-me-order-database-password
PAYMENT_DB_PASSWORD=change-me-payment-database-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
